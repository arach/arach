#!/usr/bin/env bash
# secret — store and retrieve credentials via macOS Keychain.
#
# Usage:
#   secret set <KEY>                           prompt (no echo), store value
#   secret get <KEY>                           print value to stdout
#   secret otp <NAME>                         print a fresh OTP for automation
#   secret otp list                           list enrolled OTP account names
#   secret otp code <NAME>                    explicit form (any account name)
#   secret list                                list stored key names
#   secret unset <KEY>                         delete a key
#   secret import <file> [KEY ...] [--prune]   import all or named keys from a
#                                              dotenv-style file. With --prune,
#                                              also remove the imported lines
#                                              from the source file (a backup is
#                                              written to <file>.<ts>.bak first).
#   secret status <file>                       show which keys in <file> are
#                                              already in the keychain, and
#                                              which keychain keys aren't in
#                                              <file> (migration coverage).
#   secret run [KEY ...] [--map KEY=ENV] [--otp ALIAS:ENV] -- cmd [args]
#                                              inject credentials and fresh OTPs
#                                              into a trusted child's environment.
#                                              Mapping and OTP flags may repeat.
#
# Config:  ${SECRET_CONFIG_FILE:-$HOME/.secretrc}
# Storage: macOS Keychain; service prefix is configurable.
# Index:   SECRET_INDEX_DIR/index (names only, never values).
#
# Long-lived values are printed only by `secret get`; `secret otp` prints OTPs. All status output goes
# to stderr so `$(secret get FOO)` captures the value cleanly.

set -euo pipefail

PROG="$(basename "$0")"
CONFIG_FILE="${SECRET_CONFIG_FILE:-$HOME/.secretrc}"
# Trusted local shell configuration: paths/options only, never credential values.
if [ -e "$CONFIG_FILE" ]; then
  [ -f "$CONFIG_FILE" ] || { printf 'secret: invalid config file\n' >&2; exit 1; }
  . "$CONFIG_FILE"
fi
SERVICE_PREFIX="${SECRET_SERVICE_PREFIX:-secret-cli}"
INDEX_DIR="${SECRET_INDEX_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/secret}"
if [ "${LOCALOTP_VAULT_DIR+x}" = x ]; then export LOCALOTP_VAULT_DIR; fi
INDEX_FILE="${INDEX_DIR}/index"

command -v security >/dev/null 2>&1 \
  || { printf '%s: macOS security(1) command is required\n' "$PROG" >&2; exit 1; }

mkdir -p "$INDEX_DIR"
[ -f "$INDEX_FILE" ] || touch "$INDEX_FILE"

# ---------- helpers --------------------------------------------------------

err()  { printf '%s: %s\n' "$PROG" "$*" >&2; }
die()  { err "$*"; exit 1; }
info() { printf '%s\n' "$*" >&2; }

usage() {
  /usr/bin/awk '
    NR==1 { next }
    /^[^#]/ { exit }
    { sub(/^# ?/, ""); print }
  ' "$0"
  exit "${1:-0}"
}

is_known() { /usr/bin/grep -qxF "$1" "$INDEX_FILE"; }

index_add() {
  is_known "$1" || printf '%s\n' "$1" >> "$INDEX_FILE"
  /usr/bin/sort -u -o "$INDEX_FILE" "$INDEX_FILE"
}

index_remove() {
  if [ -s "$INDEX_FILE" ]; then
    /usr/bin/grep -vxF "$1" "$INDEX_FILE" > "$INDEX_FILE.tmp" || true
    /bin/mv "$INDEX_FILE.tmp" "$INDEX_FILE"
  fi
}

kc_set() {
  /usr/bin/security add-generic-password \
    -a "$USER" \
    -s "${SERVICE_PREFIX}:$1" \
    -l "${SERVICE_PREFIX}:$1" \
    -D "secret-cli credential" \
    -w "$2" \
    -U \
    >/dev/null 2>&1
}

kc_get() {
  /usr/bin/security find-generic-password \
    -a "$USER" \
    -s "${SERVICE_PREFIX}:$1" \
    -w 2>/dev/null
}

kc_unset() {
  /usr/bin/security delete-generic-password \
    -a "$USER" \
    -s "${SERVICE_PREFIX}:$1" \
    >/dev/null 2>&1
}

# Parse one line of a dotenv file. Prints "<key>\t<value>" on a match,
# nothing otherwise. Strips a leading `export ` and surrounding quotes.
parse_env_line() {
  local line="$1"
  line="${line#"${line%%[![:space:]]*}"}"
  case "$line" in export\ *) line="${line#export }" ;; esac
  case "$line" in ''|'#'*) return 0 ;; esac
  case "$line" in [A-Za-z_]*=*) ;; *) return 0 ;; esac
  local key="${line%%=*}" value="${line#*=}"
  case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
    \'*\') value="${value#\'}"; value="${value%\'}" ;;
  esac
  printf '%s\t%s\n' "$key" "$value"
}

# ---------- subcommands ----------------------------------------------------

cmd_set() {
  local key="${1:-}"
  [ -n "$key" ] || die "usage: $PROG set <KEY>"
  local value
  if [ -t 0 ]; then
    printf 'value for %s (hidden): ' "$key" >&2
    /bin/stty -echo
    IFS= read -r value || true
    /bin/stty echo
    printf '\n' >&2
  else
    value="$(/bin/cat)"
  fi
  [ -n "$value" ] || die "empty value, refusing to store"
  kc_set "$key" "$value" || die "keychain store failed for $key"
  index_add "$key"
  info "stored: $key"
}

cmd_get() {
  local key="${1:-}"
  [ -n "$key" ] || die "usage: $PROG get <KEY>"
  local value
  value="$(kc_get "$key")" || die "not found: $key"
  printf '%s' "$value"
}

cmd_list() {
  [ -s "$INDEX_FILE" ] && /bin/cat "$INDEX_FILE" || true
}

cmd_unset() {
  local key="${1:-}"
  [ -n "$key" ] || die "usage: $PROG unset <KEY>"
  if kc_unset "$key"; then
    index_remove "$key"
    info "removed: $key"
  elif is_known "$key"; then
    index_remove "$key"
    info "removed from index (was not in keychain): $key"
  else
    die "not found: $key"
  fi
}

cmd_import() {
  local file="" prune=0
  local -a only=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --prune) prune=1 ;;
      --)      shift; break ;;
      -*)      die "unknown flag: $1" ;;
      *)       if [ -z "$file" ]; then file="$1"; else only+=("$1"); fi ;;
    esac
    shift
  done
  [ -n "$file" ] && [ -f "$file" ] \
    || die "usage: $PROG import <file> [KEY ...] [--prune]"

  local imported=0 skipped=0
  local -a imported_keys=()
  local line parsed key value match k

  while IFS= read -r line || [ -n "$line" ]; do
    parsed="$(parse_env_line "$line" || true)"
    [ -n "$parsed" ] || continue
    key="${parsed%%$'\t'*}"
    value="${parsed#*$'\t'}"

    if [ ${#only[@]} -gt 0 ]; then
      match=0
      for k in "${only[@]}"; do [ "$k" = "$key" ] && { match=1; break; }; done
      [ $match = 1 ] || continue
    fi

    if [ -z "$value" ]; then
      info "skip (empty): $key"; skipped=$((skipped + 1)); continue
    fi

    if kc_set "$key" "$value"; then
      index_add "$key"
      imported_keys+=("$key")
      info "imported: $key"
      imported=$((imported + 1))
    else
      err "failed: $key"; skipped=$((skipped + 1))
    fi
  done < "$file"

  if [ $prune = 1 ] && [ ${#imported_keys[@]} -gt 0 ]; then
    local backup="${file}.$(/bin/date +%Y%m%d-%H%M%S).bak"
    /bin/cp "$file" "$backup"
    info "backed up: $backup"
    local sed_prog=""
    for k in "${imported_keys[@]}"; do
      sed_prog+="/^[[:space:]]*\(export[[:space:]]\)\{0,1\}${k}=/d;"
    done
    /usr/bin/sed -i.tmp -e "$sed_prog" "$file"
    /bin/rm -f "${file}.tmp"
    info "pruned ${#imported_keys[@]} line(s) from $file"
  fi

  info ""
  info "imported $imported, skipped $skipped"
}

cmd_status() {
  local file="${1:-}"
  [ -n "$file" ] && [ -f "$file" ] || die "usage: $PROG status <file>"

  local file_keys
  file_keys="$(/usr/bin/awk '
    { sub(/^[[:space:]]+/, ""); sub(/^export[[:space:]]+/, "") }
    /^[A-Za-z_][A-Za-z0-9_]*=/ { sub(/=.*/, ""); print }
  ' "$file" | /usr/bin/sort -u)"

  printf 'Keys declared in %s:\n' "$file" >&2
  if [ -n "$file_keys" ]; then
    while IFS= read -r k; do
      [ -z "$k" ] && continue
      if is_known "$k"; then
        printf '  ✓ %s  (in keychain)\n' "$k" >&2
      else
        printf '  · %s  (not yet imported)\n' "$k" >&2
      fi
    done <<< "$file_keys"
  else
    printf '  (none)\n' >&2
  fi

  printf '\nKeys only in keychain (not in %s):\n' "$file" >&2
  local extras=0
  if [ -s "$INDEX_FILE" ]; then
    while IFS= read -r k; do
      [ -z "$k" ] && continue
      if [ -z "$file_keys" ] || ! /usr/bin/grep -qxF "$k" <<< "$file_keys"; then
        printf '  ✓ %s\n' "$k" >&2
        extras=$((extras + 1))
      fi
    done < "$INDEX_FILE"
  fi
  [ $extras -eq 0 ] && printf '  (none)\n' >&2
}

# Positional parameters keep injected names from clobbering our own variables.
exec_with_environment() {
  while [ "$1" -gt 0 ]; do
    # A destination may share a name with a local array; arrays cannot be
    # exported. Positional parameters retain everything needed after unset.
    unset "${2%%=*}"
    export "$2"
    set -- "$(($1 - 1))" "${@:3}"
  done
  shift
  exec "$@"
}

cmd_run() {
  # Never trace resolved values, even when this script was invoked with bash -x.
  set +x
  local -a kinds=() sources=() targets=() args=()
  local seen_dashes=0 kind source target spec previous
  while [ $# -gt 0 ]; do
    case "$1" in
      --)
        seen_dashes=1
        shift
        args=("$@")
        break
        ;;
      --map)
        [ $# -ge 2 ] || die "--map requires KEY=ENV"
        spec="$2"
        case "$spec" in *=*) ;; *) die "--map requires KEY=ENV" ;; esac
        source="${spec%%=*}"; target="${spec#*=}"; kind=key
        shift 2
        ;;
      --otp)
        [ $# -ge 2 ] || die "--otp requires ALIAS:ENV"
        spec="$2"
        case "$spec" in *:*) ;; *) die "--otp requires ALIAS:ENV" ;; esac
        source="${spec%:*}"; target="${spec##*:}"; kind=otp
        shift 2
        ;;
      -*) die "unknown secret run option" ;;
      *) source="$1"; target="$1"; kind=key; shift ;;
    esac
    [ -n "$source" ] || die "credential key or OTP alias must not be empty"
    [[ "$target" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || die "invalid destination environment variable"
    # Bash 3.2 treats an empty array expansion as unset under set -u.
    if [ ${#targets[@]} -gt 0 ]; then
      for previous in "${targets[@]}"; do
        [ "$previous" != "$target" ] || die "duplicate destination environment variable"
      done
    fi
    kinds+=("$kind"); sources+=("$source"); targets+=("$target")
  done
  [ $seen_dashes = 1 ] || die "usage: $PROG run [KEY ...] [--map KEY=ENV] [--otp ALIAS:ENV] -- cmd [args]"
  [ ${#sources[@]} -gt 0 ] || die "no credential keys or OTP aliases before --"
  [ ${#args[@]} -gt 0 ] || die "no command after --"

  local -a values=()
  local i v engine="${SECRET_OTP_BIN:-${HOME}/.local/bin/localotp}"
  # Resolve stored credentials first. Generate OTPs only after Keychain prompts
  # have completed, so their validity is not spent waiting for token access.
  for ((i=0; i<${#sources[@]}; i++)); do
    values+=("")
    if [ "${kinds[$i]}" = key ]; then
      if ! v="$(kc_get "${sources[$i]}")"; then
        die "credential lookup failed; check secret list and Keychain access"
      fi
      [ -n "$v" ] || die "credential lookup returned an empty value"
      values[$i]="$v"
    else
      [ -x "$engine" ] || die "LocalOTP executable is unavailable; configure SECRET_OTP_BIN or run the installer"
    fi
  done
  for ((i=0; i<${#sources[@]}; i++)); do
    if [ "${kinds[$i]}" = otp ]; then
      if ! v="$("$engine" code "${sources[$i]}" --stdout 2>/dev/null)"; then
        die "OTP generation failed; check secret otp list and vault access"
      fi
      [[ "$v" =~ ^[0-9]{6,8}$ ]] || die "OTP generator returned an invalid code"
      values[$i]="$v"
    fi
  done
  local -a env_pairs=()
  for ((i=0; i<${#sources[@]}; i++)); do
    env_pairs+=("${targets[$i]}=${values[$i]}")
  done
  # Export in this process and exec directly: values never become env(1) argv.
  exec_with_environment "${#env_pairs[@]}" "${env_pairs[@]}" "${args[@]}"
}

cmd_otp() {
  local engine="${SECRET_OTP_BIN:-${HOME}/.local/bin/localotp}"
  [ -x "$engine" ] || die "LocalOTP executable is unavailable; configure SECRET_OTP_BIN or run the installer"
  if [ $# -eq 1 ] && [ "$1" = "list" ]; then
    exec "$engine" list
  elif [ $# -eq 2 ] && [ "$1" = "code" ]; then
    exec "$engine" code "$2" --stdout
  elif [ $# -eq 1 ]; then
    case "$1" in
      -h|--help|help) info "usage: $PROG otp NAME | list | code NAME"; return 0 ;;
      *) exec "$engine" code "$1" --stdout ;;
    esac
  else
    die "usage: $PROG otp NAME | list | code NAME"
  fi
}

# ---------- dispatch -------------------------------------------------------

main() {
  [ $# -gt 0 ] || usage 0
  local sub="$1"; shift
  case "$sub" in
    otp)              cmd_otp    "$@" ;;
    set)              cmd_set    "$@" ;;
    get)              cmd_get    "$@" ;;
    list|ls)          cmd_list   "$@" ;;
    unset|rm|delete)  cmd_unset  "$@" ;;
    import)           cmd_import "$@" ;;
    status)           cmd_status "$@" ;;
    run|exec)         cmd_run    "$@" ;;
    -h|--help|help)   usage 0 ;;
    *)                err "unknown command: $sub"; usage 1 ;;
  esac
}

main "$@"
