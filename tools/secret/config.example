# Trusted local shell configuration. Copy to ~/.secretrc (or the file named by SECRET_CONFIG_FILE).
# Paths and options only. Never put seeds, passwords or tokens here.
SECRET_OTP_BIN="$HOME/.local/bin/localotp"
SECRET_INDEX_DIR="$HOME/.config/secret"
SECRET_SERVICE_PREFIX="secret-cli"
LOCALOTP_VAULT_DIR="$HOME/.config/localotp"
